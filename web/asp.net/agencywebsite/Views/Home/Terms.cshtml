@{
    ViewData["Title"] = "Terms & conditions";
}

<div class="container py-5">

  <div class="row mb-4">
    <div class="col-12 text-center">
      <h1 class="fw-bold">@ViewData["Title"]</h1>
      <p class="text-muted">Last updated: May 2026</p>
    </div>
  </div>

  <!-- Introduction -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card shadow-sm">
        <div class="card-body">
          <h4 class="fw-bold">1. Introduction</h4>
          <p>
            Welcome to our agency. By accessing or using our website and services,
            you agree to be bound by these Terms & Conditions. If you do not agree,
            please do not use our services.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Services -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card shadow-sm">
        <div class="card-body">
          <h4 class="fw-bold">2. Services</h4>
          <p>
            We provide digital marketing services including SEO, social media marketing,
            content creation, branding, and paid advertising management. Service scope
            will be defined in individual client agreements.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Payments -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card shadow-sm">
        <div class="card-body">
          <h4 class="fw-bold">3. Payments</h4>
          <p>
            All payments must be made according to the agreed proposal or invoice.
            Late payments may result in suspension of services. All fees are non-refundable
            unless otherwise stated in writing.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Client Responsibilities -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card shadow-sm">
        <div class="card-body">
          <h4 class="fw-bold">4. Client Responsibilities</h4>
          <p>
            Clients must provide accurate information, access to necessary accounts,
            and timely feedback. Delays in communication may affect project timelines.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Limitation -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card shadow-sm">
        <div class="card-body">
          <h4 class="fw-bold">5. Limitation of Liability</h4>
          <p>
            We are not responsible for any indirect or consequential losses arising
            from the use of our services. Results in digital marketing may vary depending
            on competition and market conditions.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Intellectual Property -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card shadow-sm">
        <div class="card-body">
          <h4 class="fw-bold">6. Intellectual Property</h4>
          <p>
            All content, designs, and materials created by our agency remain our property
            until full payment is received. After payment, ownership may transfer as agreed.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Termination -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card shadow-sm">
        <div class="card-body">
          <h4 class="fw-bold">7. Termination</h4>
          <p>
            We reserve the right to terminate services if there is a violation of terms,
            misuse of services, or non-payment of dues.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Changes -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card shadow-sm">
        <div class="card-body">
          <h4 class="fw-bold">8. Changes to Terms</h4>
          <p>
            We may update these Terms & Conditions at any time without prior notice.
            Continued use of our services means you accept the updated terms.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Contact -->
  <div class="row">
    <div class="col-12">
      <div class="card bg-dark text-white shadow-sm">
        <div class="card-body text-center">
          <h4 class="fw-bold">Contact Us</h4>
          <p class="mb-0">
            If you have any questions about these Terms & Conditions, contact us at:<br>
            <strong>email@example.com</strong>
          </p>
        </div>
      </div>
    </div>
  </div>

</div>
